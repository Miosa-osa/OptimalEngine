#!/bin/sh

# `bin/<%= @release.name %> maintenance <task> [args]` runs one Engine maintenance
# task (OptimalEngine.Release.Maintenance) in a new VM that never serves the
# HTTP API. The release script has no such command, so it becomes `eval` here,
# before the script dispatches; the task and its arguments reach the module as
# System.argv(). The shared libraries a packaged release carries in libextra/
# (deploy/Dockerfile.engine) are put on the loader path, as start-engine does,
# so the store's native libraries load without the service's environment.
if [ "$RELEASE_COMMAND" = "maintenance" ]; then
  shift
  if [ -d "$RELEASE_ROOT/libextra" ]; then
    LD_LIBRARY_PATH="$RELEASE_ROOT/libextra${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export LD_LIBRARY_PATH
  fi
  OPTIMAL_API_ENABLED=false
  export OPTIMAL_API_ENABLED
  exec "$RELEASE_ROOT/bin/$RELEASE_NAME" eval "OptimalEngine.Release.Maintenance.main()" "$@"
fi
