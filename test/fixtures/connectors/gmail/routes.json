{
  "kind": "gmail",
  "note": "Recorded shapes of the Gmail API: token refresh, a two-page message list, full-format message fetch (headers plus base64url text/plain and text/html parts), profile historyId, and an incremental history poll that also adds a promotions message and a spam message. Invented data only.",
  "routes": [
    {
      "name": "token_refresh",
      "match": {
        "method": "POST",
        "contains": "oauth2.googleapis.com/token"
      },
      "status": 200,
      "body": {
        "access_token": "ya29.example-access-token",
        "expires_in": 3599,
        "token_type": "Bearer"
      }
    },
    {
      "name": "messages_list_page_1",
      "match": {
        "method": "GET",
        "contains": "/messages?maxResults=100"
      },
      "status": 200,
      "times": 1,
      "body": {
        "messages": [
          {
            "id": "msg-0001",
            "threadId": "thread-0001"
          },
          {
            "id": "msg-0002",
            "threadId": "thread-0002"
          }
        ],
        "nextPageToken": "PAGE2",
        "resultSizeEstimate": 3
      }
    },
    {
      "name": "messages_list_page_2",
      "match": {
        "method": "GET",
        "contains": "pageToken=PAGE2"
      },
      "status": 200,
      "times": 1,
      "body": {
        "messages": [
          {
            "id": "msg-0003",
            "threadId": "thread-0003"
          }
        ],
        "resultSizeEstimate": 3
      }
    },
    {
      "name": "profile",
      "match": {
        "method": "GET",
        "contains": "/profile"
      },
      "status": 200,
      "body": {
        "emailAddress": "jane@example.com",
        "messagesTotal": 3,
        "threadsTotal": 3,
        "historyId": "900001"
      }
    },
    {
      "name": "history_poll",
      "match": {
        "method": "GET",
        "contains": "/history?startHistoryId="
      },
      "status": 200,
      "body": {
        "history": [
          {
            "id": "900002",
            "messagesAdded": [
              {
                "message": {
                  "id": "msg-0004",
                  "threadId": "thread-0004"
                }
              },
              {
                "message": {
                  "id": "msg-0005",
                  "threadId": "thread-0005"
                }
              },
              {
                "message": {
                  "id": "msg-0006",
                  "threadId": "thread-0006"
                }
              }
            ]
          }
        ],
        "historyId": "900002"
      }
    },
